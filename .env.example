# Copy to .env; set your own credentials. Never commit .env.
MYSQL_DATABASE=agent_demo
MYSQL_ROOT_PASSWORD=
AGENT_SERVICE_AUTH_TOKEN=
AGENT_SERVICE_BASE_URL=http://host.docker.internal:8000
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Pro
AGENT_CLASSIFIER_MODEL=deepseek-ai/DeepSeek-V4-Pro
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_RAG_RERANK_ENABLED=true
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AGENT_RAG_RERANK_TIMEOUT_SECONDS=15
AGENT_RAG_RERANK_MIN_SCORE=0.5
ECOMMERCE_BASE_URL=http://127.0.0.1:8081
AGENT_LOG_LEVEL=INFO
AGENT_ACCESS_LOG=false
